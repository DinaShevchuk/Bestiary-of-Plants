# Database
DATA_SOURCE=sqlite
SQLITE_DB_PATH=data/bestiary_ru.db

# LLM provider: none | ollama | openai_compatible
LLM_PROVIDER=none

# Ollama: start `ollama serve`, pull a model that supports tool calling, then set the model name.
# For OpenAI-compatible APIs, use the provider's base URL and API key.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90

# Agentic RAG limits: default 5 extra tool calls, hard maximum 10.
AGENTIC_ENABLED=true
AGENT_MAX_TOOL_CALLS=5
AGENT_MAX_CONTEXT_CHUNKS=12
MAX_CONTEXT_CHARS=24000

# Retrieval / BM25 settings from the course presentation.
DATA_FILE=data/plants.jsonl
RETRIEVAL_TOP_K=5
MIN_BM25_SCORE=0.20
BM25_K1=1.2
BM25_B=0.75

# Optional image identification. Obtain a key from the PlantNet API portal.
PLANTNET_API_KEY=
PLANTNET_API_URL=https://my-api.plantnet.org/v2/identify/all
MAX_UPLOAD_BYTES=10485760

# Optional comma-separated origins when frontend is hosted separately.
CORS_ORIGINS=
